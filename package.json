{
  "name": "citeflora",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "build:vercel": "next build",
    "build:api": "node scripts/build-api.mjs",
    "build:sites": "node scripts/run-framework.mjs build",
    "dev:vercel": "next dev --port 3000",
    "start:vercel": "next start --port 3000",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.5",
    "@babel/core": "7.29.6",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.9",
    "undici": "7.30.1",
    "ws": "8.21.0",
    "js-yaml": "4.3.2",
    "brace-expansion@>=4.0.0": "5.0.11",
    "image-size": "2.0.3",
    "esbuild@>=0.27.0": "0.28.1",
    "fflate@>=0.7.0 <0.8.0": "0.7.5",
    "satori": "0.33.5",
    "eslint-plugin-react-hooks>zod": "4.6.7",
    "brace-expansion@<2.0.0": "1.1.20"
  },
  "packageManager": "pnpm@11.25.0"
}
